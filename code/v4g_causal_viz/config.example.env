# From code/v4g_causal_viz, copy this to config.local.env and edit it.
# The scripts read these environment variables, not run_contract.json.
export H3_VIZ_ROOT="$PWD"
export H3_VIZ_SOURCE="$H3_VIZ_ROOT/inputs/VIDGEN5S_0086441.mp4"
export H3_VIZ_BASE_MODEL="$H3_VIZ_ROOT/assets/h3-base"
export H3_VIZ_UPSCALER="$H3_VIZ_ROOT/assets/latent_upsampler/minimax_h3_latent_upscaler_3d_conv_v1_bf16.safetensors"
export H3_VIZ_CHECKPOINT="$H3_VIZ_ROOT/assets/v4g_final.pt"
export H3_VIZ_UPSTREAM="$PWD/upstream"
export H3_VIZ_PYTHON="python3"
# Fill in the runtime paths appropriate to your installation.
export H3_VIZ_PYTHONPATH="/path/to/CANN/python/site-packages:/path/to/pinned-diffusers/src"
export H3_VIZ_ASCEND_OPP_PATH="/path/to/CANN/opp"
# Choose an authorized physical NPU and its EXISTING shared lock protocol.
# These paths must agree with other jobs on the host; do not invent private locks.
export H3_VIZ_PHYSICAL_NPU=""
export H3_VIZ_DEVICE_LOCK="/path/to/existing/shared-device-lock"
export H3_VIZ_TASK_LOCK="/path/to/existing/shared-task-lock"
export H3_VIZ_VAE_LOCK="/path/to/existing/shared-vae-lock"
